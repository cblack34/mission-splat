<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\rules\MissionSplat.Rules\MissionSplat.Rules.csproj" />
  </ItemGroup>

  <!-- Release output already contains Rules, so one copy publishes both assemblies. A Debug build must not replace those DLLs. -->
  <Target Name="CopyGameAssemblies" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <GamePackagePlugins>$(MSBuildThisFileDirectory)..\..\packages\com.mission-splat.game\Runtime\Plugins\</GamePackagePlugins>
    </PropertyGroup>
    <ItemGroup>
      <GameAssembly Include="$(TargetDir)MissionSplat.App.dll" />
      <GameAssembly Include="$(TargetDir)MissionSplat.Rules.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GameAssembly)" DestinationFolder="$(GamePackagePlugins)" SkipUnchangedFiles="true" />
  </Target>

</Project>
